# ─────────────────────────────────────────────────────────────────
# D&D Tabletop — Environment Variables
#
# Copy this file to .env and fill in values for your deployment.
# All keys are safe placeholders only — do not commit real secrets.
# ─────────────────────────────────────────────────────────────────

# ── Core security/auth (RECOMMENDED for founder beta) ───────────
# Stable JWT signing secret (set a long random value in production/public use).
DND_JWT_SECRET=

# Admin key for /admin/* operations (password reset + commercial admin paths).
# Sent by admin tools as the X-Admin-Key request header.
DND_ADMIN_KEY=

# ── Runtime data location overrides (optional) ───────────────────
# Default data root is OS-specific (see docs/backup-update-rollback.md).
# Set this if you want data in a custom folder.
DND_DATA_DIR=

# Optional direct DB file override.
DND_DB_PATH=

# ── Narration / TTS providers (all optional) ─────────────────────
# High-quality provider (server-side).
ELEVENLABS_API_KEY=

# Gemini TTS provider.
GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# OpenAI (used for map image generation and optional TTS fallback).
OPENAI_API_KEY=

# Replicate image provider.
REPLICATE_API_TOKEN=
# REPLICATE_MODEL=black-forest-labs/flux-1.1-pro

# Stability image provider (deprecated path; optional).
STABILITY_API_KEY=

# Anthropic key for AI cartographer planning and AI DM helpers.
ANTHROPIC_API_KEY=

# AI DM safety controls.
AI_DM_ENABLED=true
AI_DM_RATE_LIMIT_PER_MINUTE=6
AI_DM_RATE_LIMIT_PER_DAY=100
# Default allows DM and assistant DM only for NPC speech.
AI_DM_NPC_SPEAK_ALLOWED_ROLES=dm,assistant_dm

# Force an image provider (optional): openai | replicate | stability
IMAGE_PROVIDER=

# ── Hosting / Runtime mode ───────────────────────────────────────
# development: local-first defaults
# production: hosted/public-safe defaults
APP_ENV=development

# Public base URL for links/diagnostics behind domains/reverse proxies.
# Example: https://tabletop.example.com
PUBLIC_BASE_URL=

# Legacy/simple compatibility settings.
PUBLIC_DOMAIN=
PORT=8000
NGROK_DOMAIN=

# Trust X-Forwarded-For / X-Forwarded-Proto headers from a reverse proxy.
#
# Set to true ONLY when a trusted proxy (nginx, Caddy, Apache, Traefik, …) sits
# in front of this server and forwards those headers. When true the app uses the
# forwarded IP for auth rate-limiting and logging, and respects the forwarded
# protocol for secure-cookie detection.
#
# Leave false for direct internet exposure — forged X-Forwarded-For headers from
# untrusted clients could spoof any IP and bypass IP-based rate limits.
#
# See docs/hosting-access-guide.md § "TRUST_PROXY_HEADERS" for nginx/Apache/Caddy
# config snippets and an explanation of what breaks when this is wrong.
TRUST_PROXY_HEADERS=false

# ── Cookie + auth rate limits ────────────────────────────────────
AUTH_COOKIE_NAME=dnd_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict
AUTH_COOKIE_DOMAIN=

AUTH_RATE_LIMIT_ENABLED=false
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# ── Commercial layer metadata scaffold ───────────────────────────
COMMERCIAL_DEPLOYMENT_MODEL=self_host
COMMERCIAL_DEFAULT_PLAN=community
SUPPORT_CONTACT_EMAIL=
SUPPORT_PORTAL_URL=
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=
LEGAL_DPA_URL=
RELEASE_RUNBOOK_VERSION=v1

# ── Twitch Extension (viewer powers via Bits / Subs) ──────────────
# These configure the Extension Backend Service (EBS) under server/twitch_ext/.
# Create the Extension in the Twitch Developer Console (separate from the
# "Sign in with Twitch" OAuth app, same developer account). See
# extension/README.md for the full registration walkthrough.
#
# All three below are required for the EBS endpoints to come online; if any is
# missing the endpoints respond with a clear "extension not configured" error
# instead of crashing.
TWITCH_EXT_CLIENT_ID=
TWITCH_EXT_SECRET=          # base64 extension secret from the console (signs all Extension JWTs)
TWITCH_EXT_OWNER_ID=        # your Twitch user id (extension owner)
#
# Optional — only needed for the subscriber "claim sub power" path, which
# server-verifies sub status via the Twitch Helix API (a client App Access
# Token). If unset, /sub-claim refuses rather than trusting the client claim.
TWITCH_EXT_CLIENT_SECRET=
# Comma-separated power ids a subscriber may claim for free (must exist in
# VIEWER_POWER_DEFS). Defaults to a safe support power if unset.
TWITCH_EXT_SUB_POWERS=healing_spark,battle_blessing
# Seconds a viewer must wait between sub-power claims.
TWITCH_EXT_SUB_COOLDOWN_SEC=900

# ── Twitch In-App OAuth (DM "Connect Twitch" button) ─────────────
# Register a Twitch application at https://dev.twitch.tv/console/apps
# with redirect URI: {PUBLIC_BASE_URL}/api/twitch/callback
# Required for the in-app Twitch channel connection flow.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# AES-256-GCM encryption key for storing Twitch tokens at rest.
# Generate with:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# If unset, a temporary key is auto-generated on startup (tokens lost on restart).
TWITCH_TOKEN_ENC_KEY=

# ── Twitch Chat Bridge ────────────────────────────────────────────
# Shared secret between the game server and the chat-bridge service.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CHAT_BRIDGE_TOKEN=

# If true, chat participants are preserved in the session DB between restarts.
# Default false (runtime-only).
CHAT_BRIDGE_PERSIST_PARTICIPANTS=false

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
