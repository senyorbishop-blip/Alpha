# ─────────────────────────────────────────────────────────────────────────────
# Tavern Tabletop — Twitch Chat Bridge
# Copy to .env and fill in values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Twitch bot identity ──────────────────────────────────────────────────────
# Username of the bot account that joins your channel.
TWITCH_BOT_USERNAME=my_tavern_bot

# OAuth token for the bot account (format: oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
# Generate at: https://twitchapps.com/tmi/  (use the bot account, not your main)
TWITCH_OAUTH_TOKEN=oauth:your_token_here

# Your channel name (without the #).
TWITCH_CHANNEL=your_channel_name

# ── Twitch app credentials (required for EventSub sub/bits/raid loot) ────────
# Create an app at https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Your Twitch user ID (not username). Get it from:
#   curl -H "Client-Id: <CLIENT_ID>" -H "Authorization: Bearer <USER_TOKEN>" \
#        https://api.twitch.tv/helix/users?login=your_channel_name
TWITCH_BROADCASTER_ID=

# ── Game server ──────────────────────────────────────────────────────────────
# WebSocket URL of the running game server (no trailing slash).
GAME_SERVER_WS_URL=ws://localhost:8000

# Session ID to connect the bridge to. Find it in the DM's browser URL
# (e.g. http://localhost:8000/play/abc123def456 → session ID is abc123def456).
GAME_SESSION_ID=your_session_id_here

# Shared secret between the bridge and game server. Must match CHAT_BRIDGE_TOKEN
# in the game server's .env.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CHAT_BRIDGE_TOKEN=your_shared_secret_here
